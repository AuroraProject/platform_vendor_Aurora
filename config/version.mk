AURORA_DATE_YEAR := $(shell date -u +%Y)
AURORA_DATE_MONTH := $(shell date -u +%m)
AURORA_DATE_DAY := $(shell date -u +%d)
AURORA_DATE_HOUR := $(shell date -u +%H)
AURORA_DATE_MINUTE := $(shell date -u +%M)
AURORA_BUILD_DATE_UTC := $(shell date -d '$(AURORA_DATE_YEAR)-$(AURORA_DATE_MONTH)-$(AURORA_DATE_DAY) $(AURORA_DATE_HOUR):$(AURORA_DATE_MINUTE) UTC' +%s)
AURORA_BUILD_DATE := $(AURORA_DATE_YEAR)$(AURORA_DATE_MONTH)$(AURORA_DATE_DAY)-$(AURORA_DATE_HOUR)$(AURORA_DATE_MINUTE)

AURORA_DISPLAY_VERSION := 3.0

AURORA_PLATFORM_VERSION := 15.0

AURORA_VERSION := v$(AURORA_DISPLAY_VERSION)-$(AURORA_BUILD)-$(AURORA_PLATFORM_VERSION)-$(AURORA_BUILD_DATE)

# Signing
-include vendor/aurora-priv/keys/keys.mk
